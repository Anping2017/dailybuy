# ==== Supabase (云端数据同步; 不配置则仅用 localStorage) ====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==== Admin API 鉴权 (生产环境必设; 不设置则 admin routes 会拒绝所有请求) ====
# 生成: openssl rand -hex 32
# 使用: 调用 /api/admin/* 时带 header X-Admin-Token: <ADMIN_TOKEN>
ADMIN_TOKEN=

# ==== Anthropic Claude API (可选, AI 菜谱生成) ====
# 仅在 server-side 使用; 不可暴露给 client
ANTHROPIC_API_KEY=

# ==== 注意事项 ====
# 1. 此文件是模板, 实际 key 写在 .env.local (已被 gitignore)
# 2. 若曾将真实 key 推到 git, 立刻 git filter-branch / BFG 清理, 并在 Supabase/Anthropic 后台轮换 key
# 3. NEXT_PUBLIC_ 前缀的变量会打进前端 bundle, 只放公开的 anon key; service_role 严禁用此前缀
